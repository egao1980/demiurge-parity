[0.000, "o", "generic runner command=RESUME dir=/Users/nikolaimatiushev/Projects/cl-workspace/demiurge-parity-g2/demos/s7-resume/\r\n\r\n── S7 durability — 2-step journal, child SBCL kill, parent replay\r\n   look at: journal replay counts: before-count, after-count, fresh-1/fresh-2, side-effect counts\r\n"]
[0.000, "o", "\r\n── Launching a child SBCL that journals step-1, writes a side-effect, then aborts\r\n   look at: shared SQLite journal: one STEP-COMPLETED before resume\r\n"]
[0.971, "o", "\r\n── Parent replayed the journal and continued with step-2\r\n   before-count (steps before resume; expect 1): 1\r\n   after-count (steps after resume; expect 2): 2\r\n   step-names (expect step-1 step-2): (\"step-1\" \"step-2\")\r\n   fresh-1 (step-1 body re-executed? expect 0): 0\r\n   fresh-2 (step-2 ran on resume? expect 1): 1\r\n   effect-1 (side-effect written exactly once): 1\r\n   effect-2 (side-effect written on resume): 1\r\n\r\n── Replay contract: step-1 came from the journal (fresh-1=0); step-2 executed once.\r\n\r\n── S7 done. Reviewer: before-count=1, after-count=2, fresh-1=0, fresh-2=1, effects=1/1.\r\n"]
